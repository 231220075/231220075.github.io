# 英超数据代理服务器环境变量配置
# 复制此文件为 .env 并填入真实的API密钥

# Football-Data.org API密钥
# 免费注册：https://www.football-data.org/client/register
# 免费额度：每月10次请求
FOOTBALL_DATA_TOKEN=your_football_data_token_here

# RapidAPI API密钥 (用于API-Sports)
# 免费注册：https://rapidapi.com/api-sports/api/api-football
# 免费额度：每天100次请求
RAPIDAPI_KEY=your_rapidapi_key_here

# 服务器端口（可选，默认3001）
PORT=3001

# 缓存时间（秒，默认600=10分钟）
CACHE_TTL=600

# 允许的跨域来源（用逗号分隔）
ALLOWED_ORIGINS=http://localhost:4000,https://231220075.github.io,http://127.0.0.1:4000

# 日志级别
LOG_LEVEL=info
