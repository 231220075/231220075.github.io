{
  "version": 2,
  "name": "premier-league-proxy",
  "builds": [
    {
      "src": "proxy-server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/proxy-server.js"
    }
  ],
  "env": {
    "FOOTBALL_DATA_TOKEN": "@football_data_token"
  }
}
